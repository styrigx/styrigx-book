{
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "foliate-js": "^1.0.1",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  },
  "description": "个人电子书库 book.styrigx.com",
  "name": "styrigx-book",
  "scripts": {
    "build:css": "tailwindcss -c web/tailwind.config.js -i web/assets/css/input.css -o web/assets/css/main.css --minify",
    "build": "npm run build:css && hugo --minify -s web",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/web/*.test.mjs tests/workers/book-api/*.test.mjs",
    "test:visual": "playwright test --config=tests/config/playwright.visual.config.js",
    "test:e2e": "playwright test --config=tests/config/playwright.e2e.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "miniflare": "4.20260730.0"
  },
  "version": "1.2.0"
}
